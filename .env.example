# -----------------------------------------------------------------------------
# Game Intelligence - local / deployment environment example
# Copy this file to .env and fill in real secrets. Never commit .env.
# -----------------------------------------------------------------------------

# Database
# Local defaults below preserve the current development environment.
# For deployment, replace every password with a strong secret.
DB_NAME=game_news_db
DB_USER=manager
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Optional localhost-only development ports
MARIADB_HOST_PORT=3379
KAFKA_HOST_PORT=9092
EUREKA_HOST_PORT=8761
GATEWAY_HOST_PORT=8080

# Production frontend port (docker-compose.prod.yml)
FRONTEND_HTTP_PORT=80

# Game News JWT
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=game-news-key-1
JWT_ISSUER=game-news
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# API Gateway CORS
# Local/ngrok direct development access can be added here.
# In production, the bundled Nginx proxies /api on the same origin, so CORS is
# normally not required unless the frontend and API are intentionally split.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
