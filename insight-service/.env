# /docker-compose.yml (운영 환경 : 컨테이너 실행용 - 실제 적용값)
# /insight-service/app/config/setting.py (아무 설정도 없을 경우 이 셋팅으로 동작 - 기본값)
# /insight-service/.env (개발 환경 : 로컬 직접 실행용)

# 서버 설정
APP_PORT=8085
APP_NAME=insight-service

# Eureka 설정
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost

# Auth Server (JWT 검증)
JWT_ISSUER_URI=http://localhost:8080
JWK_SET_URI=http://auth-server:9000/oauth2/jwks

# 서비스 URL (Eureka 미사용 시 직접 지정)
ENROLLMENT_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_URL=http://localhost:8082

# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=insight-service
KAFKA_TOPIC_ENROLLMENT_COMPLETED=enrollment.completed
