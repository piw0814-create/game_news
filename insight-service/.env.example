# ----------------------------------------------------------------------------
# Insight Service - local/direct-run environment example
# Docker Compose also loads this file, then overrides internal network/runtime
# values such as NEWS_SERVICE_URL and KAFKA_BOOTSTRAP_SERVERS where necessary.
# Copy to insight-service/.env and never commit the real .env.
# ----------------------------------------------------------------------------

APP_PORT=8085
APP_NAME=insight-service

# Direct local execution defaults
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost
JWT_ISSUER_URI=game-news
JWK_SET_URI=http://localhost:8081/api/auth/jwks
NEWS_SERVICE_URL=http://localhost:8082
NEWS_SERVICE_TIMEOUT_SECONDS=10
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=insight-service
KAFKA_TOPIC_NEWS_CREATED=news.created
KAFKA_RETRY_DELAY_SECONDS=5

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_CONTENT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_TOPIC_MATCH_MAX_OUTPUT_TOKENS=500
OPENAI_TOPIC_ANALYSIS_MAX_OUTPUT_TOKENS=900

# Topic integration / analysis
TOPIC_CANDIDATE_WINDOW_HOURS=48
TOPIC_CANDIDATE_DB_LIMIT=10
TOPIC_CANDIDATE_AI_LIMIT=3
TOPIC_MATCH_CONFIDENCE_THRESHOLD=0.85
TOPIC_ANALYSIS_ARTICLE_LIMIT=10

# Recovery defaults for direct local execution.
# docker-compose.yml currently sets the same values explicitly for containers.
ANALYSIS_RECOVERY_ENABLED=true
ANALYSIS_RECOVERY_LIMIT=20
ANALYSIS_RECOVERY_MAX_TOTAL=200
ANALYSIS_RECOVERY_PROCESSING_STALE_MINUTES=15
ANALYSIS_RECOVERY_STARTUP_RETRY_COUNT=10
ANALYSIS_RECOVERY_STARTUP_RETRY_DELAY_SECONDS=3
ANALYSIS_RECOVERY_CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
ANALYSIS_RECOVERY_PERIODIC_ENABLED=true
ANALYSIS_RECOVERY_PERIODIC_INTERVAL_SECONDS=1800
ANALYSIS_RECOVERY_PERIODIC_MAX_TOTAL=100
ANALYSIS_RECOVERY_PERIODIC_PENDING_STALE_MINUTES=15
