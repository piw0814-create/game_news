# 로컬에서 insight-service를 직접 실행할 때 사용합니다.
APP_PORT=8085
APP_NAME=insight-service

EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost

JWT_ISSUER_URI=game-news
JWK_SET_URI=http://localhost:8081/api/auth/jwks

NEWS_SERVICE_URL=http://localhost:8082
NEWS_SERVICE_TIMEOUT_SECONDS=10

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=insight-service
KAFKA_TOPIC_NEWS_CREATED=news.created
KAFKA_RETRY_DELAY_SECONDS=5

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_CONTENT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_KNOWN_GAMES_LIMIT=200

# 미등록 게임 AI 자동 등록

# Topic 자동 통합
OPENAI_TOPIC_MATCH_MAX_OUTPUT_TOKENS=500
TOPIC_CANDIDATE_WINDOW_HOURS=48
TOPIC_CANDIDATE_DB_LIMIT=10
TOPIC_CANDIDATE_AI_LIMIT=3
TOPIC_MATCH_CONFIDENCE_THRESHOLD=0.85
OPENAI_TOPIC_ANALYSIS_MAX_OUTPUT_TOKENS=900
TOPIC_ANALYSIS_ARTICLE_LIMIT=10
