# Vite 개발 서버 전용 설정입니다.
# 실제 브라우저 API 호출은 /api 상대 경로를 사용합니다.

# 로컬 개발 시 Vite가 프록시할 API Gateway 주소
VITE_API_PROXY_TARGET=http://localhost:8080

# ngrok 등 외부 도메인으로 Vite dev server에 접근할 때만 설정합니다.
# 스킴(https://) 없이 호스트명만 작성하고, 여러 개면 쉼표로 구분합니다.
# 예: VITE_ALLOWED_HOSTS=example.ngrok-free.app
VITE_ALLOWED_HOSTS=
